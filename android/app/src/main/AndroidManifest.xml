<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Für die Datenquelle "Automatisch"/"Live": tagesaktuelle Daten von
         GitHub Pages. Die App funktioniert auch vollständig OFFLINE mit den
         gebündelten Daten – ohne Verbindung fällt sie darauf zurück. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tägliche Erinnerung. Ab Android 13 muss das Recht zusätzlich zur
         Laufzeit erfragt werden (siehe MainActivity). Ohne Zustimmung bleibt
         die Funktion einfach aus; die App fragt nur, wenn der Nutzer die
         Erinnerung selbst einschaltet. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Damit eine eingeschaltete Erinnerung einen Neustart des Geräts
         übersteht. Geweckt wird mit einem UNGENAUEN Alarm – der braucht kein
         SCHEDULE_EXACT_ALARM, und für eine Tageserinnerung ist die Minute
         ohnehin nicht entscheidend. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Eigene Aktualisierung: die App laedt die neue APK und uebergibt sie
         dem Paketinstallierer des Systems. Installiert wird NICHT von der App,
         sondern vom System nach ausdruecklicher Zustimmung - das Recht erlaubt
         nur, den Installationsdialog zu OEFFNEN.
         Gebraucht wird das fuer die Direktverteilung: eine APK von GitHub kann
         sich sonst nicht selbst erneuern.
         ⚠️ Fuer eine spaetere Fassung im Google Play Store muss diese Zeile
         RAUS - Selbstaktualisierung ausserhalb des Stores ist dort untersagt.
         Bei F-Droid ist sie unerwuenscht, weil F-Droid einen eigenen Updater
         mitbringt.
         ⚠️ Der Bauschalter `mitUpdater` in app/build.gradle schaltet die
         FUNKTION ab (BuildConfig.MIT_UPDATER), entfernt diese Zeile aber
         NICHT - fuer F-Droid reicht das, fuer Google Play nicht. Dort braucht
         es zusaetzlich productFlavors mit eigenem Manifest-Zweig. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ⚠️ allowBackup steht bewusst auf "false".
         In den App-Daten liegt die Liste der Petitionen, die der Nutzer
         unterschrieben hat (localStorage des WebView) – also eine politische
         Interessenspur. Mit "true" kopiert Androids automatische Sicherung
         diese Daten in das Google-Konto des Nutzers, und auf Android 11 und
         älter zog `adb backup` sie über ein angestecktes Kabel heraus. Für eine
         Petitions-App ist beides der falsche Vorgabewert.
         Was dadurch entfällt: die automatische Wiederherstellung auf einem
         neuen Gerät. Ersatz gibt es in der App selbst – „Sicherung
         exportieren/importieren" schreibt dieselben Daten auf ausdrücklichen
         Wunsch nach Downloads (BackupBridge in MainActivity).
         Rückgängig machen heißt: hier auf "true" ändern. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Ab Android 7 darf keine file://-Adresse mehr an eine fremde App
             gereicht werden (FileUriExposedException). Der Paketinstallierer
             bekommt deshalb eine content://-Adresse aus diesem Provider.
             Die Pfade stehen in res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Empfängt den Tagesalarm und den Gerätestart. android:exported ist
             bewusst "false": nur das System und die App selbst dürfen ihn
             auslösen, sonst könnte jede andere App die Meldung erzeugen. -->
        <receiver
            android:name=".NotifyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
