# Startet den täglichen Pflege-Lauf. Persistent=true holt einen verpassten
# Lauf beim nächsten Einschalten des Rechners nach — feste Uhrzeiten sind
# damit unkritisch.
[Unit]
Description=Täglicher PetitionsManager-Pflege-Lauf

[Timer]
OnCalendar=*-*-* 20:15
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
